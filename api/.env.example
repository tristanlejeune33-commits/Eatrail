# ─── Database (Railway Postgres) ──────────────────────────
# Railway gives you this URL in the Postgres service "Connect" tab.
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public&sslmode=require
DATABASE_URL="postgresql://postgres:password@localhost:5432/eatrail?schema=public"

# ─── Server ───────────────────────────────────────────────
PORT=3001
NODE_ENV=development

# ─── Auth ─────────────────────────────────────────────────
# Random 64+ char string. Generate one with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
SESSION_SECRET=change-me-to-a-random-64-char-string
SESSION_COOKIE_NAME=eatrail_session
SESSION_DAYS=30
BCRYPT_ROUNDS=10

# Where the IP-hash salt comes from (rotates abuse signals; rotate every 90d)
IP_HASH_SALT=change-me-too

# ─── CORS ─────────────────────────────────────────────────
# Comma-separated list of allowed origins (the SPA). For dev: http://localhost:8080 or file://.
ALLOWED_ORIGINS=http://localhost:8080,http://127.0.0.1:8080

# ─── AI features (Claude / Anthropic) ────────────────────
# REQUIRED for: pantry photo scan + AI shop ingredient inference.
# Get a key at: https://console.anthropic.com/settings/keys
# Default model: claude-opus-4-7 (our most capable; high-res vision included).
# Cost order of magnitude:
#   - Pantry scan: ~$0.02/photo
#   - Shop inference: ~$0.005/shop with prompt caching (~90% cheaper after warmup)
ANTHROPIC_API_KEY=

# ─── Optional: legacy / external services ─────────────────
# OPENAI_API_KEY was the previous AI provider (Whisper, GPT-4o-mini Vision, DALL-E).
# Kept here as legacy fallback for `web/app/scripts/fetch-images.js --openai`
# (DALL-E recipe image generation, only). All runtime AI calls now use Anthropic.
OPENAI_API_KEY=
PEXELS_API_KEY=

# ─── Optional: Geo-discovery (Google Places API) ──────────
# Without this, /api/geo/shops/nearby falls back to the 30 curated NYC shops only.
# Get a key at: https://console.cloud.google.com/google/maps-apis
# Enable "Places API" in the GCP project, then create an API key with HTTP referrer or IP restriction.
# Free tier: $200/mo (≈ 11.000 Place Details requests). With our 30-day cache, easily sufficient.
GOOGLE_PLACES_API_KEY=

# ─── Optional: Nutrition (USDA FoodData Central) ─────────
# Free, get a key at: https://fdc.nal.usda.gov/api-key-signup.html
# Without this, /api/nutrition/recipe/:id returns null values.
USDA_API_KEY=

# ─── Optional: Mapbox (interactive map on shops page) ─────
# Get token at: https://account.mapbox.com/access-tokens/
# Free tier: 50K map loads/month. Without it, app shows list view only.
MAPBOX_TOKEN=

# ─── Optional: Web Push (notifications) ───────────────────
# Generate a pair with: npx web-push generate-vapid-keys
# Public key is exposed to client; private key stays server-side.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:contact@eatrail.com

# ─── Optional: Google OAuth login ─────────────────────────
# Create OAuth 2.0 client at: https://console.cloud.google.com/apis/credentials
# Authorized redirect URI: https://your-app.up.railway.app/api/auth/google/callback
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=

# ─── Single-service deploy toggle ─────────────────────────
# Set to "false" if you serve the SPA from a separate host (Vercel/Netlify).
# Default: serve web/app/* from Express in production.
SERVE_STATIC=true
